# Database — local dev uses Postgres; swap for your hosted URL in prod.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokenshelf?schema=public"

# Auth.js
#   AUTH_SECRET: openssl rand -base64 32
#   AUTH_URL:    base URL of this app
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub OAuth — create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Encryption — 32 random bytes, hex-encoded. Generates with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to envelope-encrypt provider API keys in ProviderConnection.secretCipher.
ENCRYPTION_KEY=""

# Receipt signing — ed25519 PKCS#8 PEM. Generates with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# The matching public key is auto-published at /.well-known/tokenshelf-verify.json
SIGNING_PRIVATE_KEY=""

# Cron — protect /api/cron/sync-all. In Vercel set this as a project secret;
# Vercel Cron passes it as Authorization: Bearer <secret>.
CRON_SECRET=""

# Provider API bases (override for staging/mocks; defaults are production)
ANTHROPIC_API_BASE="https://api.anthropic.com"
OPENAI_API_BASE="https://api.openai.com"
GITHUB_API_BASE="https://api.github.com"
