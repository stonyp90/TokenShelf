# Database — local dev uses Postgres; swap for your hosted URL in prod.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokenshelf?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub OAuth — create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: provider keys used by /api/sync to pull usage on behalf of the user.
# Per-user keys are stored in ProviderConnection rows; these are only for
# admin-side checks or the demo seed.
ANTHROPIC_ADMIN_API_KEY=""
OPENAI_ADMIN_API_KEY=""
